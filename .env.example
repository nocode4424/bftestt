# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
# Use a single publishable key var and set it per environment (test or live)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Backend secret key: set this to either your TEST or LIVE secret key depending on environment
# Example (test): STRIPE_SECRET_KEY=sk_test_********************************
# Example (live): STRIPE_SECRET_KEY=sk_live_********************************
STRIPE_SECRET_KEY=your_stripe_secret_key

# Webhook secret corresponds to the endpoint created in the same Stripe mode (test or live)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_endpoint_secret

# Email Service Configuration
RESEND_API_KEY=your_resend_api_key_here

# Test Mode Configuration
VITE_TEST_MODE=false

# Domain Configuration (for production deployment)
# This application is configured for bluefinwc.com domain
# Ensure DNS/hosting is configured with the following domains:
# - menu.bluefinwc.com (customer ordering interface)
# - admin.bluefinwc.com (analytics dashboard - NEW!)
# - orders.bluefinwc.com (kitchen display system)
VITE_MENU_DOMAIN=menu.bluefinwc.com
VITE_ADMIN_DOMAIN=admin.bluefinwc.com
VITE_KITCHEN_DOMAIN=orders.bluefinwc.com


# Admin Authentication
ADMIN_JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# Order Alert System
ORDER_ALERT_SECRET=your-shared-secret-here
MAC_DISPATCH_URL=http://192.168.1.100:7777
PORT=8000
LISTEN_PORT=7777